# Server-side only. Enables model-backed answers for live public GitHub repositories.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional: raises the GitHub API rate limit for public repository reads.
# Use a fine-grained token with public repository read access only.
GITHUB_TOKEN=
# Optional OpenAI-compatible Groq endpoint override:
# GROQ_BASE_URL=https://api.groq.com/openai/v1
